rules_version = '2';
// Cutover-only ruleset: blocks every client read/write while the Firestore
// database is exported, recreated in asia-northeast3 and re-imported.
// Admin SDK traffic is not affected; freeze it with scripts/freeze_old_backend.sh.
// Deploy with: firebase deploy --config firebase.cutover.json --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
