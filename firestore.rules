rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gemini 번역 캐시는 Cloud Functions(Admin SDK)만 읽고 쓴다.
    match /content_translations/{translationId} {
      allow read, write: if false;
    }
    // YouTube 링크 미리보기 캐시는 Admin SDK에서만 관리한다.
    match /linkPreviewCache/{cacheId} {
      allow read, write: if false;
    }
    // 부분 문자열 검색용 n-gram은 서버 전용 파생 데이터다. 원본 콘텐츠의
    // 공개범위를 우회하거나 클라이언트가 인덱스를 오염시킬 수 없도록 한다.
    match /post_search_index/{postId} {
      allow read, write: if false;
    }
    match /meetup_search_index/{meetupId} {
      allow read, write: if false;
    }

    function isValidPostCategoryKey(value) {
      return value is string && value in [
        'style',
        'create',
        'photo',
        'content',
        'cafe',
        'academic_study',
        'books_writing',
        'travel_local',
        'global',
        'other'
      ];
    }

    function isValidPostCategoryKeys(value) {
      return value is list
        && value.size() >= 1
        && value.size() <= 10
        && value.toSet().size() == value.size()
        && value.toSet().hasOnly([
          'style',
          'create',
          'photo',
          'content',
          'cafe',
          'academic_study',
          'books_writing',
          'travel_local',
          'global',
          'other'
        ]);
    }

    // ===== 스낵샷 접근 제어 =====
    // canonical 문서는 상세 화면/Storage 접근의 최종 권한 원본이다.
    // 목록은 서버가 생성한 users/{uid}/snapshot_feed만 본인이 읽는다.
    function snapshotAllowedVisibility(value) {
      return value is string && value in ['public', 'friends', 'category'];
    }

    function snapshotBlockFree(authorId) {
      return !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + authorId))
        && !exists(/databases/$(database)/documents/blocks/$(authorId + '_' + request.auth.uid));
    }

    // Firebase Auth 비활성화와 별개로 Firestore에 기록된 정지/탈퇴 상태도
    // 콘텐츠 공개범위보다 우선한다. 삭제 후 지연된 merge로 uid/token만 남은
    // 껍데기 문서도 활성 계정으로 인정하지 않는다.
    function activeUserAccount(userId) {
      return userId is string
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('isDeleted', false) != true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('deleted', false) != true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('disabled', false) != true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('isSuspended', false) != true
        && get(/databases/$(database)/documents/users/$(userId)).data.get('deletedAt', null) == null
        && get(/databases/$(database)/documents/users/$(userId)).data.get('status', '') != 'deleted'
        && get(/databases/$(database)/documents/users/$(userId)).data.get('status', '') != 'suspended'
        && get(/databases/$(database)/documents/users/$(userId)).data.get('accountStatus', '') != 'deleted'
        && get(/databases/$(database)/documents/users/$(userId)).data.get('accountStatus', '') != 'suspended'
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.get('registrationStatus', '') == 'complete'
          || (
            get(/databases/$(database)/documents/users/$(userId)).data.get('registrationStatus', '') == ''
            && get(/databases/$(database)/documents/users/$(userId)).data.get('emailVerified', false) == true
            && get(/databases/$(database)/documents/users/$(userId)).data.get('nickname', '') != ''
          )
        );
    }

    function currentUserAccountAllowed() {
      return request.auth != null && activeUserAccount(request.auth.uid);
    }

    function accountRestrictionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isDeleted', 'deleted', 'disabled', 'isSuspended', 'status',
        'emailVerified', 'hanyangEmail', 'hanyangEmailVerified',
        'hanyangEmailVerifiedAt', 'schoolVerificationMethod',
        'schoolVerificationSchemaVersion', 'schoolVerificationUpdatedAt',
        'verificationMethod', 'isAdmin',
        'pendingHanyangEmail', 'pendingHanyangVerificationLinked',
        'pendingHanyangVerifiedAt',
        'signupState', 'registrationStatus', 'registrationCompletedAt'
      ]);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function hasFrozenAudience(data) {
      return data.get('visibilitySchemaVersion', 0) >= 2
        && data.keys().hasAll([
          'ownerId', 'visibilityMode', 'audienceUserIdsFrozen',
          'sourceGroupIds', 'visibilityLockedAt', 'visibilitySchemaVersion'
        ])
        && data.ownerId is string
        && data.visibilityMode in ['public', 'friends', 'category']
        && data.audienceUserIdsFrozen is list
        && data.sourceGroupIds is list
        && data.visibilityLockedAt is timestamp
        && data.ownerId in data.audienceUserIdsFrozen;
    }

    function frozenAudienceCanRead(data) {
      return hasFrozenAudience(data)
        && (
          request.auth.uid == data.ownerId
          || data.visibilityMode == 'public'
          || request.auth.uid in data.audienceUserIdsFrozen
        );
    }

    function visibilityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerId', 'userId', 'authorId',
        'visibilityMode', 'visibility',
        'audienceUserIdsFrozen', 'allowedUserIds',
        'sourceGroupIds', 'visibleToCategoryIds',
        'visibilityLockedAt', 'visibilitySchemaVersion',
        'isAnonymous',
        'publicDurationHours', 'publicExpiresAt', 'publicExpiredAt',
        'publicWindowStatus', 'expiredAt'
      ]);
    }

    function canReadSnapshot(snapshotData) {
      return currentUserAccountAllowed()
        && snapshotData.keys().hasAll(['status', 'createdAt', 'expiresAt'])
        && snapshotData.status == 'active'
        && snapshotData.expiresAt is timestamp
        && request.time < snapshotData.expiresAt
        && (
          request.auth.uid == snapshotData.get('ownerId', snapshotData.get('authorId', ''))
          || (
            snapshotBlockFree(snapshotData.get('ownerId', snapshotData.get('authorId', '')))
            && (
              frozenAudienceCanRead(snapshotData)
              // 레거시 fallback은 문서에 이미 저장된 UID만 사용한다.
              || snapshotAllowedVisibility(snapshotData.get('visibility', ''))
                && (
                  snapshotData.get('visibility', '') == 'public'
                  || request.auth.uid in snapshotData.get('allowedUserIds', [])
                )
            )
          )
        );
    }

    // ===== 밋업(모임) 만료 판정 유틸 =====
    // - endsAt(타임스탬프)가 있으면 그 값을 우선 사용(시간까지 정확)
    // - 없으면 date(타임스탬프) + 1일(자정 기준)로 fallback
    // - 레거시 문서(date가 문자열 등)로 만료를 판정할 수 없으면 기존 동작을 유지(차단하지 않음)
    function meetupNotExpired(meetupDoc) {
      return (meetupDoc.data.keys().hasAny(['endsAt']) && meetupDoc.data.endsAt is timestamp)
        ? request.time < meetupDoc.data.endsAt
        : ((meetupDoc.data.keys().hasAny(['date']) && meetupDoc.data.date is timestamp)
            ? request.time < meetupDoc.data.date + duration.value(1, 'd')
            : true);
    }

    // 미확정 밋업의 공개 제한시간은 서버에서 생성하고 확정/만료 함수만
    // 변경한다. 레거시 클라이언트의 직접 확정도 제한시간 이후에는 막는다.
    function meetupPublicationWindowOpen(meetupData) {
      return meetupData.get('publicWindowStatus', '') != 'expired'
        && (!meetupData.keys().hasAny(['publicExpiresAt'])
          || (meetupData.publicExpiresAt is timestamp
            && request.time < meetupData.publicExpiresAt));
    }

    function canReadPostData(postData) {
      return currentUserAccountAllowed()
        && (
          frozenAudienceCanRead(postData)
          || request.auth.uid == postData.get('userId', '')
          || postData.get('visibility', '') == 'public'
          || request.auth.uid in postData.get('allowedUserIds', [])
        );
    }

    function canReadMeetupData(meetupData) {
      // 공개범위 필드가 없거나 알 수 없는 레거시 문서는 공개로 추정하지 않습니다.
      // Firestore Rules는 필터가 아니므로 아래 세 조건은 클라이언트의
      // `userId == uid`, `visibility == public`, `allowedUserIds array-contains uid`
      // 쿼리와 각각 직접 대응해야 합니다. hasAll/is-list 같은 추가 조건을 붙이면
      // 쿼리 엔진이 안전성을 증명하지 못해 결과가 없어도 전체 쿼리를 거부합니다.
      // 필드가 없으면 get()의 기본값으로 어느 조건도 통과하지 않아 fail-closed입니다.
      return currentUserAccountAllowed()
        && (
          frozenAudienceCanRead(meetupData)
          || request.auth.uid == meetupData.get('userId', '')
          || meetupData.get('visibility', '') == 'public'
          || request.auth.uid in meetupData.get('allowedUserIds', [])
        );
    }

    function validMeetupAudience(meetupData) {
      return meetupData.keys().hasAll([
          'userId', 'visibility', 'visibleToCategoryIds'
        ])
        && meetupData.visibility in ['public', 'friends', 'category']
        && meetupData.visibleToCategoryIds is list
        && (
          (
            meetupData.visibility == 'public'
            && (
              !meetupData.keys().hasAny(['allowedUserIds'])
              || (
                meetupData.allowedUserIds is list
                && meetupData.userId in meetupData.allowedUserIds
              )
            )
          )
          || (
            meetupData.visibility in ['friends', 'category']
            && meetupData.keys().hasAny(['allowedUserIds'])
            && meetupData.allowedUserIds is list
            && meetupData.userId in meetupData.allowedUserIds
            && (meetupData.visibility != 'category'
              || meetupData.visibleToCategoryIds.size() > 0)
          )
        );
    }

    // ===== 한양메일 점유 상태(서버 전용) =====
    match /email_claims/{emailId} {
      allow read, write: if false;
    }
    // Nickname uniqueness is enforced by Cloud Functions transactions only.
    // It is not a searchable nickname directory.
    match /nicknameClaims/{nicknameKey} {
      allow read, write: if false;
    }
    // ===== 이메일 인증 코드 컬렉션 =====
    // 앱 클라이언트에서 직접 접근하지 못하도록 전면 차단 (클라우드 함수 전용)
    match /email_verifications/{emailId} {
      allow read, write: if false;
    }
    // 6자리 비밀번호 재설정 코드는 Cloud Functions에서만 관리한다.
    match /passwordResetCodes/{emailKey} {
      allow read, write: if false;
    }
    // 관리자 메일의 중복 발송 방지 영수증은 Cloud Functions만 관리한다.
    match /admin_notification_receipts/{receiptId} {
      allow read, write: if false;
    }

    
    // ===== 사용자 컬렉션 =====
    match /users/{userId} {
      // 프로필 조회는 한양메일 인증 여부와 무관하다. 한양인 전용
      // 포스트·밋업은 각 콘텐츠 규칙에서 별도로 제한한다.
      allow read: if request.auth != null;
      // 가입 및 학교 인증 상태는 Cloud Functions(Admin SDK)만 생성한다.
      // 클라이언트가 hanyangEmailVerified=true를 직접 넣어 인증을 위조할 수
      // 없도록 users 문서의 직접 생성도 차단한다.
      allow create: if false;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && accountRestrictionFieldsUnchanged()
        // 읽지 않은 수는 Cloud Functions만 유지한다. 본인 문서라도
        // 클라이언트가 배지/메시지 카운터를 임의 변경할 수 없다.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'dmUnreadTotal', 'dmUnreadCounterVersion',
          'notificationUnreadTotal',
          'friendsCount',
          'nickname', 'nicknameKey', 'nicknameSearchTokens',
          'nicknameUpdatedAt'
        ]);
      allow delete: if false; // 사용자 삭제는 금지
      
      // 저장된 게시글 서브컬렉션
      match /savedPosts/{postId} {
        // 본인만 자신의 저장된 게시글 읽기/쓰기 가능
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cloud Functions가 공개 범위/친구/차단을 검증해 만든 개인 피드.
      // 클라이언트는 자신의 피드만 읽으며 직접 생성/수정할 수 없다.
      match /snapshot_feed/{snapshotId} {
        allow read: if currentUserAccountAllowed() && request.auth.uid == userId;
        allow write: if false;
      }
      
      // DM 대화방 서브컬렉션 (백업용)
      match /conversations/{conversationId} {
        // 본인만 자신의 대화방 목록 읽기/쓰기 가능
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 학기 To-do 완료 상태. 운영자 원본과 분리하여 본인만 접근한다.
      match /todoProgress/{progressId} {
        function validProgress(data) {
          return data.semesterId is string
            && data.taskId is string
            && data.weekNumber is int
            && data.weekNumber >= 1
            && data.weekNumber <= 30
            && data.isCompleted is bool;
        }

        allow read: if currentUserAccountAllowed() && request.auth.uid == userId;
        allow create: if currentUserAccountAllowed()
          && request.auth.uid == userId
          && validProgress(request.resource.data);
        allow update: if currentUserAccountAllowed()
          && request.auth.uid == userId
          && validProgress(request.resource.data)
          && request.resource.data.semesterId == resource.data.semesterId
          && request.resource.data.taskId == resource.data.taskId
          && request.resource.data.weekNumber == resource.data.weekNumber;
        allow delete: if currentUserAccountAllowed() && request.auth.uid == userId;
      }

      // 사용자가 직접 만든 개인 To-do.
      match /personalTodos/{todoId} {
        allow read: if currentUserAccountAllowed() && request.auth.uid == userId;
        // 개인 할 일은 기기 로컬 저장소 전용이다. 읽기는 구버전 데이터의
        // 1회 로컬 이전을 위해서만 유지하고 신규 서버 쓰기는 차단한다.
        allow create, update, delete: if false;
      }

      // 개인 To-do 알림의 사용자 전체 스위치.
      // 항목별 reminderEnabled와 분리되어 전체 OFF 시에도 항목 설정은 유지된다.
      match /notificationSettings/{settingId} {
        // 인증 상태 복구 직후에도 본인 설정은 읽고 끌 수 있어야 한다.
        // 다른 사용자의 설정에는 접근할 수 없다.
        allow read: if request.auth != null && request.auth.uid == userId;
        // 알림 설정과 예약도 기기 로컬 전용이다.
        allow create, update, delete: if false;
      }

      // FCM 기기 레지스트리는 Cloud Functions에서만 갱신한다.
      match /devices/{deviceId} {
        allow read: if currentUserAccountAllowed() && request.auth.uid == userId;
        allow write: if false;
      }
      
      // 사용자 프로필 게시글 (후기 등)
      match /posts/{postId} {
        // 레거시 앱은 이 서브컬렉션을 직접 조회한다. 기존 읽기 조건을
        // 유지하고, 신규 프로필의 공개 후기 미리보기는 App Check가 적용된
        // getPublicProfileReviewPreview 함수에서 동의 완료 상태까지 검증한다.
        allow read: if 
          request.auth != null &&
          (request.auth.uid == userId ||
           (!resource.data.keys().hasAny(['isHidden']) || !resource.data.isHidden));
        
        // 생성: 본인만 가능 (후기 작성 시)
        // type='meetup_review'이고 authorId가 본인인 경우에만 허용
        allow create: if 
          request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.type == 'meetup_review' &&
          request.resource.data.authorId == userId;
        
        // 수정: 
        // 1) 본인: isHidden, updatedAt 필드 변경 가능
        // 2) 본인: 후기 수정 시 imageUrls, imageUrl, content, updatedAt 필드 변경 가능
        // 3) 모든 인증된 사용자: likedBy, likeCount 필드 변경 가능 (좋아요 기능)
        // 4) 모든 인증된 사용자: commentCount 필드 변경 가능 (댓글 수 업데이트)
        allow update: if 
          request.auth != null &&
          (
            // 본인: 숨김 처리
            (request.auth.uid == userId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden', 'updatedAt'])) ||
            
            // 본인: 후기 수정 (모임 후기인 경우)
            (request.auth.uid == userId &&
             resource.data.type == 'meetup_review' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrls', 'imageUrl', 'content', 'updatedAt'])) ||
            
            // 모든 사용자: 좋아요 토글
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount']) ||
            
            // 모든 사용자: 댓글 수 업데이트
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          );
        
        // 삭제: 본인만 가능 (후기 삭제 시)
        allow delete: if 
          request.auth != null &&
          request.auth.uid == userId;
      }
    }

    // ===== 학기별 To-do List =====
    // 할 일은 민감한 사용자 데이터가 아닌 운영 콘텐츠다. 활성 계정은 공개된
    // 주차의 활성 항목을 읽고 앱에서 현재 선택한 학생 유형에 맞게 표시한다.
    // 사용자 문서와 화면의 학생 유형이 일시적으로 달라도 조회 전체가 거부되지
    // 않도록 audience 일치 여부는 클라이언트 쿼리에 맡긴다.
    match /semesters/{semesterId} {
      allow read: if isAdmin()
        || (currentUserAccountAllowed() && resource.data.status == 'active');
      allow write: if isAdmin();

      match /weeks/{weekId} {
        function activeSemester() {
          return get(/databases/$(database)/documents/semesters/$(semesterId)).data.status == 'active';
        }

        allow read: if isAdmin()
          || (currentUserAccountAllowed()
            && activeSemester()
            && resource.data.isPublished == true);
        allow write: if isAdmin();

        match /tasks/{taskId} {
          function publishedWeek() {
            return get(/databases/$(database)/documents/semesters/$(semesterId)/weeks/$(weekId)).data.isPublished == true;
          }

          allow read: if isAdmin()
            || (currentUserAccountAllowed()
              && activeSemester()
              && publishedWeek()
              && resource.data.isActive == true);
          allow write: if isAdmin();
        }
      }
    }

    // ===== 24시간 스낵샷 canonical 문서 =====
    // 생성/수정/삭제/반응은 서버 Callable만 수행하여 createdAt/expiresAt,
    // 작성자 정보와 공개 범위를 클라이언트가 위조하지 못하게 한다.
    match /snapshots/{snapshotId} {
      // 목록은 users/{uid}/snapshot_feed 접근 인덱스만 사용한다. canonical
      // 문서는 상세/검증용 단건 읽기만 허용해 차단 검사가 쿼리 전체를
      // permission-denied로 만드는 문제와 메타데이터 노출을 함께 막는다.
      allow get: if canReadSnapshot(resource.data);
      allow list: if false;
      allow write: if false;

      match /reactions/{userId} {
        // 현재 사용자는 자신의 반응 여부만 확인하고, 스낵 작성자는
        // 조회 목록에서 반응자를 함께 확인할 수 있다. 작성은 Callable만 수행한다.
        allow get: if request.auth != null
          && ((request.auth.uid == userId
              && canReadSnapshot(
                get(/databases/$(database)/documents/snapshots/$(snapshotId)).data
              ))
            || request.auth.uid == get(
              /databases/$(database)/documents/snapshots/$(snapshotId)
            ).data.get('ownerId', get(
              /databases/$(database)/documents/snapshots/$(snapshotId)
            ).data.get('authorId', '')));
        allow list: if request.auth != null
          && request.auth.uid == get(
            /databases/$(database)/documents/snapshots/$(snapshotId)
          ).data.get('ownerId', get(
            /databases/$(database)/documents/snapshots/$(snapshotId)
          ).data.get('authorId', ''));
        allow create, update, delete: if false;
      }

      match /comments/{userId} {
        // 신규 코멘트는 사용자 UID 문서로 한 번만 저장한다. 현재 사용자는
        // 자신의 전송 여부만 확인할 수 있고 본문 목록은 노출하지 않는다.
        allow get: if request.auth != null
          && request.auth.uid == userId
          && canReadSnapshot(
            get(/databases/$(database)/documents/snapshots/$(snapshotId)).data
          );
        allow list, create, update, delete: if false;
      }

      match /views/{viewerId} {
        // 조회 기록은 서버만 작성한다. 목록은 부모 스냅샷의 작성자에게만
        // 허용하며, 만료/공개범위 판정과 결합해 list 쿼리가 거부되지 않게
        // 소유권만 독립적으로 확인한다.
        allow read: if request.auth != null
          && request.auth.uid == get(
            /databases/$(database)/documents/snapshots/$(snapshotId)
          ).data.get('ownerId', get(
            /databases/$(database)/documents/snapshots/$(snapshotId)
          ).data.get('authorId', ''));
        allow create, update, delete: if false;
      }
    }
    
    // ===== 친구 요청 컬렉션 =====
    match /friend_requests/{requestId} {
      // 요청 생성: 발신자만 가능, 자기 자신에게 요청 금지
      allow create: if 
        currentUserAccountAllowed() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.auth.uid != request.resource.data.toUid &&
        activeUserAccount(request.resource.data.toUid) &&
        request.resource.data.status == 'PENDING';
      
      // 요청 읽기: 발신자 또는 수신자만 가능
      // requestId 형식: {fromUid}_{toUid}
      // 문서가 없어도 읽기 허용 (존재 여부 확인용)
      allow read: if 
        request.auth != null &&
        (
          // 문서가 존재하는 경우: 관련 당사자만
          (resource != null &&
           (request.auth.uid == resource.data.fromUid || 
            request.auth.uid == resource.data.toUid)) ||
          // 문서가 존재하지 않는 경우: requestId 패턴에 자신의 ID 포함 시
          (resource == null &&
           requestId.matches('.*' + request.auth.uid + '.*'))
        );
      
      // 요청 업데이트: 상태 전이 규칙 적용
      allow update: if 
        request.auth != null &&
        (
          // PENDING → CANCELED: 발신자만 가능
          (resource.data.status == 'PENDING' && 
           request.resource.data.status == 'CANCELED' &&
           request.auth.uid == resource.data.fromUid) ||
          
          // PENDING → ACCEPTED/REJECTED: 수신자만 가능
          (resource.data.status == 'PENDING' && 
           (request.resource.data.status == 'ACCEPTED' || 
            request.resource.data.status == 'REJECTED') &&
           request.auth.uid == resource.data.toUid)
        );
      
      // 요청 삭제: 금지 (상태 변경으로 처리)
      allow delete: if false;
    }
    
    // ===== 친구 관계 컬렉션 =====
    match /friendships/{pairId} {
      // 읽기: 인증된 모든 사용자가 읽을 수 있음 (친구 관계 확인용)
      // pairId 형식: {uid1}__{uid2} (사전순 정렬)
      allow read: if request.auth != null;
      
      // 쓰기: 클라우드 함수만 가능 (보안 강화)
      allow write: if false;
    }
    
    // ===== 차단 컬렉션 =====
    match /blocks/{blockId} {
      // 읽기: 차단 관계에 포함된 사용자 모두 확인 가능
      // blockId 형식: {blocker}_{blocked}
      // 문서가 없어도 읽기 허용 (존재 여부 확인용)
      allow read: if
        request.auth != null &&
        (
          // 문서가 존재하는 경우: 관련 당사자만
          (resource != null &&
           (request.auth.uid == resource.data.blocker ||
            request.auth.uid == resource.data.blocked)) ||
          // 문서가 존재하지 않는 경우: blockId 패턴에 자신의 ID 포함 시
          (resource == null &&
           blockId.matches('.*' + request.auth.uid + '.*'))
        );

      // 생성/삭제/업데이트: Cloud Functions만 가능 (보안 강화)
      allow write: if false;
    }
    
    // ===== 관계(Relationships) 컬렉션 =====
    match /relationships/{relationshipId} {
      // 읽기: 본인과 관련된 관계만 읽기 가능
      allow read: if 
        request.auth != null &&
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
      
      // 생성: 본인이 userId인 경우만 가능
      allow create: if 
        request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      
      // 업데이트: 본인과 관련된 관계만 수정 가능
      allow update: if 
        request.auth != null &&
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
      
      // 삭제: 본인과 관련된 관계만 삭제 가능
      allow delete: if 
        request.auth != null &&
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
    }
    
    // ===== 친구 카테고리 컬렉션 =====
    match /friend_categories/{categoryId} {
      // 읽기: 본인의 카테고리 또는 내가 포함된 카테고리 읽기 가능
      allow read: if 
        request.auth != null &&
        (request.auth.uid == resource.data.userId || 
         request.auth.uid in resource.data.friendIds);
      
      // 생성: 본인이 userId인 경우만 가능
      allow create: if 
        request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      
      // 업데이트: 본인의 카테고리만 수정 가능
      allow update: if 
        request.auth != null &&
        request.auth.uid == resource.data.userId;
      
      // 삭제: 본인의 카테고리만 삭제 가능
      allow delete: if 
        request.auth != null &&
        request.auth.uid == resource.data.userId;
    }
    
    // ===== 기존 컬렉션들 (호환성 유지) =====
    match /posts/{postId} {
      // 게시글 읽기: 공개 범위에 따라 제한
      // 1. 전체 공개(visibility == 'public' 또는 필드 없음) → 인증된 사용자만 읽기 가능
      // 2. 카테고리별 공개(visibility == 'category') → allowedUserIds에 포함된 사용자만 읽기 가능
      allow read: if canReadPostData(resource.data);
      
      // 신규 문서는 createPostSecure(Admin SDK)에서만 생성한다.
      allow create: if false;
      
      // 게시글 수정: 작성자만 가능 또는 좋아요/조회수 필드만 변경하는 경우 읽기 권한이 있는 사용자 가능
      // userId='deleted'는 수정 불가 (탈퇴한 사용자 게시글 보호)
      allow update: if request.auth != null && 
        resource.data.userId != 'deleted' &&
        // 읽기 권한 체크 (전체 공개 또는 허용된 사용자)
        canReadPostData(resource.data) &&
        // categoryKey를 변경할 때만 taxonomy를 검증합니다. 레거시 문서의
        // 좋아요/조회수 업데이트는 마이그레이션 전에도 계속 허용됩니다.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['categoryKey', 'categoryKeys']) ||
         (isValidPostCategoryKey(request.resource.data.categoryKey) &&
          isValidPostCategoryKeys(request.resource.data.categoryKeys) &&
          request.resource.data.categoryKey == request.resource.data.categoryKeys[0])) &&
        // createdAt 필드는 절대 수정 불가
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])) &&
        // 외부 링크 미리보기는 createPostSecure가 검증해 저장하며 클라이언트가
        // 게시 후 임의 URL/썸네일로 교체할 수 없다.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkPreview'])) &&
        visibilityFieldsUnchanged() &&
        (request.auth.uid == resource.data.userId ||
         // 좋아요 필드만 변경하는 경우 누구나 가능 (읽기 권한이 있으면)
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) ||
         // 조회수 필드만 변경하는 경우 누구나 가능 (읽기 권한이 있으면)
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) ||
         // 투표 카운트 업데이트 (1인 1표 로직은 앱/트랜잭션에서 처리)
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollOptions', 'pollTotalVotes']));
      
      // 게시글 삭제: 작성자만 가능 (userId='deleted'는 삭제 불가)
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId &&
        resource.data.userId != 'deleted';
      
      // 게시글의 댓글
      match /comments/{commentId} {
        function canReadParentPost() {
          let postPath = /databases/$(database)/documents/posts/$(postId);
          return exists(postPath) && canReadPostData(get(postPath).data);
        }

        allow read: if canReadParentPost();
        allow create: if request.auth != null
          && canReadParentPost()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true;
        allow update: if request.auth != null 
          && canReadParentPost()
          && resource.data.userId != 'deleted'
          && request.auth.uid == resource.data.userId;
        allow delete: if request.auth != null 
          && canReadParentPost()
          && resource.data.userId != 'deleted'
          && request.auth.uid == resource.data.userId;
      }

      // 투표 참여(1인 1표): posts/{postId}/pollVotes/{uid}
      match /pollVotes/{voteId} {
        // 이 게시글을 "볼 수 있는지" (기존 posts 읽기 규칙과 동일)
        function canReadThisPost() {
          let postPath = /databases/$(database)/documents/posts/$(postId);
          let post = get(postPath);
          return exists(postPath) && canReadPostData(post.data);
        }

        // 본인만 자신의 투표 상태 읽기
        allow read: if request.auth != null && request.auth.uid == voteId && canReadThisPost();

        // 본인만 투표 생성 가능
        // - 일부 계정 플로우에서 users 문서의 emailVerified 조건 때문에 투표가 막힐 수 있어,
        //   MVP에서는 인증된 사용자라면 투표를 허용합니다.
        allow create: if request.auth != null
          && canReadThisPost()
          && request.auth.uid == voteId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.optionId is string;

        // 수정/삭제 금지 (MVP: 투표 변경/취소 불가)
        allow update, delete: if false;
      }
    }
    
    match /meetups/{meetupId} {
      // 보안 규칙은 필터가 아니므로 목록 쿼리도 visibility/allowedUserIds/userId 중
      // 하나를 명시해야 합니다. 권한 없는 밋업 문서는 기기로 내려가지 않습니다.
      allow get: if canReadMeetupData(resource.data);
      allow list: if canReadMeetupData(resource.data);
      // 신규 문서는 createMeetupSecure(Admin SDK)에서만 생성한다.
      allow create: if false;
      
      // 업데이트 규칙 세분화
      allow update: if request.auth != null && (
        // 주최자의 일반 정보 수정. 확정/완료/후기 작성/만료 이후에는
        // 클라이언트가 화면을 우회해도 더 이상 내용을 바꿀 수 없다.
        (request.auth.uid == resource.data.userId
          && resource.data.get('isConfirmed', false) != true
          && resource.data.get('isCompleted', false) != true
          && resource.data.get('hasReview', false) != true
          && meetupNotExpired(resource)
          && meetupPublicationWindowOpen(resource.data)
          && validMeetupAudience(request.resource.data)
          && request.resource.data.maxParticipants is int
          && request.resource.data.maxParticipants >= 3
          && request.resource.data.maxParticipants <= 10
          && request.resource.data.maxParticipants >= request.resource.data.currentParticipants
          && visibilityFieldsUnchanged()
          // Snack Chat linkage is owned by createMeetupSnackChatSecure so a
          // client cannot point a Meetup at an unrelated room or clear it.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'snackChatId', 'groupChatEnabled',
            'isConfirmed', 'isCompleted', 'hasReview', 'reviewId',
            'publicDurationHours', 'publicExpiresAt', 'publicExpiredAt',
            'publicWindowStatus', 'expiredAt'
          ])
        ) ||
        // 완료/후기 상태 전환은 기존 후기 플로우에서 계속 사용할 수 있다.
        // 콘텐츠 및 공개 범위 필드는 이 분기로 변경할 수 없다.
        (request.auth.uid == resource.data.userId
          && (resource.data.get('isCompleted', false) != true
            || request.resource.data.get('isCompleted', false) == true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isCompleted', 'hasReview', 'reviewId', 'updatedAt'
          ])) ||
        // 확정/만료 뒤에도 댓글 수 메타데이터 동기화는 기존대로 유지한다.
        // 제목·설명·일정 등 모임 콘텐츠는 이 분기로 변경할 수 없다.
        (request.auth.uid == resource.data.userId
          && request.resource.data.get('commentCount', 0) is int
          && request.resource.data.get('commentCount', 0) >= 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentCount', 'updatedAt'
          ])) ||
        // 참여자는 currentParticipants만 수정 가능 (참여/취소 시)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentParticipants', 'updatedAt']) &&
         canReadMeetupData(resource.data) &&
         meetupNotExpired(resource) &&
         request.resource.data.currentParticipants is int &&
         request.resource.data.currentParticipants >= 1 &&
         request.resource.data.currentParticipants <= resource.data.maxParticipants + 1) ||
        // 조회수 필드만 변경하는 경우 누구나 가능
        (canReadMeetupData(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'updatedAt']))
      );
      
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId &&
        resource.data.get('isConfirmed', false) != true;
      
      // 모임의 댓글
      match /comments/{commentId} {
        function canReadParentMeetup() {
          let meetupPath = /databases/$(database)/documents/meetups/$(meetupId);
          return exists(meetupPath) && canReadMeetupData(get(meetupPath).data);
        }

        allow read: if canReadParentMeetup();
        allow create: if request.auth != null
          && canReadParentMeetup()
          && meetupPublicationWindowOpen(
            get(/databases/$(database)/documents/meetups/$(meetupId)).data
          )
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true;
        allow update: if request.auth != null 
          && canReadParentMeetup()
          && resource.data.userId != 'deleted'
          && request.auth.uid == resource.data.userId;
        allow delete: if request.auth != null 
          && canReadParentMeetup()
          && resource.data.userId != 'deleted'
          && request.auth.uid == resource.data.userId;
      }

      // NOTE: 단체 톡방(확성기) 기능 제거됨 (2026-02)
      // - 기존 경로 접근 전면 차단
      match /group_chat_messages/{messageId} {
        allow read, write: if false;
      }
      match /group_chat_members/{memberId} {
        allow read, write: if false;
      }
    }

    // NOTE: "meetup_chats" 기반 단체 톡방 기능 제거됨 (2026-02)
    match /meetup_chats/{meetupId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
    
    // ===== 모임 후기 컬렉션 =====
    match /meetup_reviews/{reviewId} {
      // 읽기 허용 범위:
      //  - 후기 작성자(authorId)
      //  - 수락한 참여자(approvedParticipants)
      //  - 수락 대기 중인 참여자(pendingParticipants) → 후기 내용을 확인 후 수락/거절할 수 있어야 함
      allow read: if 
        request.auth != null &&
        (
          request.auth.uid == resource.data.authorId ||
          (resource.data.keys().hasAny(['approvedParticipants']) && request.auth.uid in resource.data.approvedParticipants) ||
          (resource.data.keys().hasAny(['pendingParticipants']) && request.auth.uid in resource.data.pendingParticipants)
        );
      
      // 생성: 모임장만 후기 생성 가능 (emailVerified 확인)
      allow create: if 
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true &&
        request.auth.uid == request.resource.data.authorId &&
        request.resource.data.keys().hasAll(['meetupId']) &&
        exists(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)) &&
        get(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)).data.userId == request.auth.uid &&
        (
          get(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)).data.get('isConfirmed', false) == true ||
          get(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)).data.get('isCompleted', false) == true
        );
      
      // 수정: 
      //  1) 모임장은 모든 필드 수정 가능
      //  2) 참여자는 자신의 UID를 pendingParticipants에서 제거하고 
      //     approvedParticipants 또는 rejectedParticipants에 추가하는 것만 가능
      allow update: if 
        request.auth != null &&
        (
          // 모임장: 모든 수정 가능
          request.auth.uid == resource.data.authorId ||
          
          // 참여자: 자신의 수락/거절 처리만 가능
          (
            // 현재 pendingParticipants에 포함되어 있고
            (resource.data.keys().hasAny(['pendingParticipants']) && request.auth.uid in resource.data.pendingParticipants) &&
            
            // pendingParticipants에서 자신을 제거하고
            (request.resource.data.keys().hasAny(['pendingParticipants']) && !(request.auth.uid in request.resource.data.pendingParticipants)) &&
            
            // approvedParticipants 또는 rejectedParticipants에 자신을 추가하며
            (
              (request.resource.data.keys().hasAny(['approvedParticipants']) && request.auth.uid in request.resource.data.approvedParticipants) ||
              (request.resource.data.keys().hasAny(['rejectedParticipants']) && request.auth.uid in request.resource.data.rejectedParticipants)
            ) &&
            
            // 다른 필드는 변경하지 않음 (authorId, content, imageUrl 등)
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.meetupId == resource.data.meetupId &&
            request.resource.data.content == resource.data.content &&
            request.resource.data.imageUrl == resource.data.imageUrl
          )
        );
      
      // 삭제: 모임장만 후기 삭제 가능
      allow delete: if 
        request.auth != null &&
        request.auth.uid == resource.data.authorId;
    }
    
    // ===== 모임 후기 수락 요청 컬렉션 =====
    match /review_requests/{requestId} {
      // 읽기: 요청자(requesterId) 또는 수신자(recipientId)만 읽기 가능
      allow read: if 
        request.auth != null &&
        (request.auth.uid == resource.data.requesterId ||
         request.auth.uid == resource.data.recipientId);
      
      // 생성: 모임장(requesterId)이 자신의 후기에 대해 참여자들에게 요청 생성 가능
      allow create: if 
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true &&
        request.resource.data.keys().hasAll(['meetupId', 'recipientId', 'metadata']) &&
        request.resource.data.metadata is map &&
        request.resource.data.metadata.keys().hasAll(['reviewId']) &&
        exists(/databases/$(database)/documents/meetup_reviews/$(request.resource.data.metadata.reviewId)) &&
        request.resource.data.requesterId == get(/databases/$(database)/documents/meetup_reviews/$(request.resource.data.metadata.reviewId)).data.authorId &&
        get(/databases/$(database)/documents/meetup_reviews/$(request.resource.data.metadata.reviewId)).data.meetupId == request.resource.data.meetupId &&
        exists(/databases/$(database)/documents/meetup_participants/$(request.resource.data.meetupId + '_' + request.resource.data.recipientId)) &&
        get(/databases/$(database)/documents/meetup_participants/$(request.resource.data.meetupId + '_' + request.resource.data.recipientId)).data.status == 'approved' &&
        (
          // 호스트가 실제 참여자에게 요청을 생성
          request.auth.uid == request.resource.data.requesterId ||
          // 레거시 누락 요청은 수락 대기 대상인 수신자 본인만 복구
          (
            request.auth.uid == request.resource.data.recipientId &&
            request.auth.uid in get(/databases/$(database)/documents/meetup_reviews/$(request.resource.data.metadata.reviewId)).data.pendingParticipants
          )
        );
      
      // 수정: 요청자 또는 수신자만 수정 가능 (상태 업데이트)
      allow update: if 
        request.auth != null &&
        (request.auth.uid == resource.data.requesterId ||
         request.auth.uid == resource.data.recipientId);
      
      // 삭제: 요청자만 삭제 가능
      allow delete: if 
        request.auth != null &&
        request.auth.uid == resource.data.requesterId;
    }
    
    // ===== 모임 참여자 컬렉션 =====
    match /meetup_participants/{participantId} {
      function participantMeetupExists(meetupId) {
        return meetupId is string
          && exists(/databases/$(database)/documents/meetups/$(meetupId));
      }

      function canReadParticipantMeetup(meetupId) {
        return participantMeetupExists(meetupId)
          && canReadMeetupData(
            get(/databases/$(database)/documents/meetups/$(meetupId)).data
          );
      }

      // 단건 참여 상태 조회:
      // - 아직 참여 문서가 없어 resource.data가 없는 경우에도
      //   `{meetupId}_{본인 uid}` 형식의 본인 문서 확인은 허용합니다.
      // - 다른 사용자의 참여 문서는 해당 밋업 공개 대상만 조회할 수 있습니다.
      allow get: if request.auth != null && (
        participantId.matches('^.+_' + request.auth.uid + '$')
        || (
          resource.data.meetupId is string
          && canReadParticipantMeetup(resource.data.meetupId)
        )
      );

      // 내 참여 밋업 조회와 특정 밋업 참여자 조회를 별도 allow로 분리합니다.
      // Firestore는 보안 규칙을 필터처럼 사용하지 않으므로, cross-document
      // 검사를 같은 OR 식에 넣으면 `where(userId == uid)` 쿼리도 거부될 수 있습니다.
      allow list: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow list: if request.auth != null
        && resource.data.meetupId is string
        && canReadParticipantMeetup(resource.data.meetupId);
      
      // 참여 생성은 joinMeetupSecure Cloud Function만 수행합니다. 저장된
      // allowedUserIds가 오래되었거나 클라이언트가 변조되어도 직접 참여할 수 없습니다.
      allow create: if false;
      
      // 업데이트: 본인 또는 모임 주최자만 수정 가능
      allow update: if 
        request.auth != null &&
        resource.data.meetupId is string &&
        exists(/databases/$(database)/documents/meetups/$(resource.data.meetupId)) &&
        canReadMeetupData(
          get(/databases/$(database)/documents/meetups/$(resource.data.meetupId)).data
        ) &&
        meetupNotExpired(get(/databases/$(database)/documents/meetups/$(resource.data.meetupId))) &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == get(
           /databases/$(database)/documents/meetups/$(resource.data.meetupId)
         ).data.userId);
      
      // 본인은 언제든 자신의 잘못된/만료된 참여를 정리할 수 있고,
      // 주최자는 공개 대상에서 제외된 기존 참여자를 정리할 수 있습니다.
      allow delete: if 
        request.auth != null &&
        resource.data.meetupId is string &&
        exists(/databases/$(database)/documents/meetups/$(resource.data.meetupId)) &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == get(
           /databases/$(database)/documents/meetups/$(resource.data.meetupId)
         ).data.userId);
    }
    
    // ===== 리뷰 합의 기능 추가 규칙 =====
    
    // 관리자 설정 (Feature Flags 등)
    match /admin_settings/{document} {
      // 읽기: 로그인한 사용자만 가능 (Feature Flag 확인용)
      allow read: if request.auth != null;
      
      // 쓰기: 관리자만 가능
      allow write: if 
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 사용자 설정 (알림 설정 등 기존 기능 확장)
    match /user_settings/{userId} {
      // 본인만 읽기/쓰기 가능
      allow read, write: if 
        request.auth != null && 
        request.auth.uid == userId;
    }

    // 모임별 리뷰 요청 (meetings/{meetupId}/pendingReviews/{reviewId})
    match /meetings/{meetupId}/pendingReviews/{reviewId} {
      // 리뷰 요청 읽기: 요청자 또는 수신자만 가능
      allow read: if 
        request.auth != null &&
        (request.auth.uid == resource.data.requesterId || 
         request.auth.uid == resource.data.recipientId);
      
      // 리뷰 요청 생성: 요청자만 가능, 해당 모임 참여자여야 함
      allow create: if 
        request.auth != null &&
        request.auth.uid == request.resource.data.requesterId &&
        // 모임 참여자인지 확인
        request.auth.uid in get(/databases/$(database)/documents/meetups/$(meetupId)).data.participants &&
        // 수신자도 참여자인지 확인
        request.resource.data.recipientId in get(/databases/$(database)/documents/meetups/$(meetupId)).data.participants &&
        // 자기 자신에게 요청하지 않음
        request.auth.uid != request.resource.data.recipientId &&
        // 초기 상태는 pending이어야 함
        request.resource.data.status == 'pending';
      
      // 리뷰 요청 업데이트: 수신자만 상태 변경 가능
      allow update: if 
        request.auth != null &&
        request.auth.uid == resource.data.recipientId &&
        // 기존 상태가 pending이어야 함
        resource.data.status == 'pending' &&
        // 새 상태는 accepted 또는 rejected만 가능
        (request.resource.data.status == 'accepted' || 
         request.resource.data.status == 'rejected') &&
        // 다른 필드는 변경하지 않음 (상태와 응답 시간, 메시지만)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'responseMessage']);
      
      // 삭제 금지 (상태 변경으로만 관리)
      allow delete: if false;
    }

    // 모임별 리뷰 합의 결과 (meetings/{meetupId}/reviews/{consensusId})
    match /meetings/{meetupId}/reviews/{consensusId} {
      // 리뷰 합의 읽기: 해당 모임 참여자만 가능
      allow read: if 
        request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/meetups/$(meetupId)).data.participants;
      
      // 리뷰 합의 생성: 서버 사이드 로직으로만 생성 (Cloud Functions)
      // 클라이언트에서 직접 생성 금지
      allow create: if false;
      
      // 리뷰 합의 업데이트/삭제: 금지 (불변 데이터)
      allow update, delete: if false;
    }

    // 알림 컬렉션 (기존 확장)
    match /notifications/{notificationId} {
      // 본인의 알림만 읽기 가능
      allow read: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // 알림 생성: 인증된 사용자만 생성 가능
      allow create: if request.auth != null;
      
      // 알림 업데이트: 본인만 읽음 상태 변경 가능
      allow update: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId &&
        // 읽음 상태만 변경 가능
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      
      // 알림 삭제: 본인만 가능
      allow delete: if 
        request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // ===== 광고 배너 컬렉션 =====
    match /ad_banners/{bannerId} {
      // 모든 사용자가 광고를 읽을 수 있음
      allow read: if true;
      
      // 광고 생성/수정/삭제는 Firebase Console에서만 가능
      // (관리자가 직접 관리)
      allow write: if false;
    }
    
    // ===== 추천 장소 컬렉션 =====
    match /recommended_places/{category} {
      // 모든 사용자가 추천 장소를 읽을 수 있음
      allow read: if true;
      
      // 쓰기는 Firebase Console에서만 가능 (관리자가 직접 관리)
      allow write: if false;
    }
    
    // ===== 후기(Reviews) 컬렉션 =====
    match /reviews/{reviewId} {
      // 읽기: 본인의 후기 또는 공개된 후기만 읽기 가능
      allow read: if 
        request.auth != null &&
        (request.auth.uid == resource.data.authorId || 
         resource.data.privacyLevel == 'public' ||
         (resource.data.privacyLevel == 'friends' && 
          exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + resource.data.authorId))) ||
         (resource.data.privacyLevel == 'school' && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school == 
          get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.school));
      
      // 생성: 클라우드 함수만 가능 (모임 후기 자동 발행)
      allow create: if false;
      
      // 수정: 본인의 후기만 수정 가능 (hidden 필드 변경)
      allow update: if
        request.auth != null &&
        request.auth.uid == resource.data.authorId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'updatedAt']);
      
      // 삭제: 본인의 후기만 삭제 가능
      allow delete: if 
        request.auth != null &&
        request.auth.uid == resource.data.authorId;
    }
    
    // ===== 댓글(Comments) 컬렉션 (최상위) =====
    match /comments/{commentId} {
      function canReadCommentTarget(commentData) {
        let targetId = commentData.postId;
        let postPath = /databases/$(database)/documents/posts/$(targetId);
        let meetupPath = /databases/$(database)/documents/meetups/$(targetId);
        return request.auth != null
          && targetId is string
          && (
            (exists(postPath) && canReadPostData(get(postPath).data))
            || (exists(meetupPath) && canReadMeetupData(get(meetupPath).data))
            || (!exists(postPath) && !exists(meetupPath))
          );
      }

      function validTopLevelCommentThread(data) {
        return data.get('parentCommentId', null) == null
          && data.depth == 0
          && data.get('replyToCommentId', null) == null
          && data.get('replyToUserId', null) == null;
      }

      function validReplyCommentThread(data) {
        let parentId = data.parentCommentId;
        let targetId = data.replyToCommentId;
        let parentPath = /databases/$(database)/documents/comments/$(parentId);
        let targetPath = /databases/$(database)/documents/comments/$(targetId);
        let parent = get(parentPath).data;
        let target = get(targetPath).data;
        return parentId is string
          && parentId.size() > 0
          && targetId is string
          && targetId.size() > 0
          && data.depth == 1
          && exists(parentPath)
          && exists(targetPath)
          && parent.postId == data.postId
          && parent.get('parentCommentId', null) == null
          && parent.get('isDeleted', false) != true
          && target.postId == data.postId
          && target.get('isDeleted', false) != true
          && (targetId == parentId
            || target.get('parentCommentId', '') == parentId)
          && data.replyToUserId is string
          && data.replyToUserId == target.userId;
      }

      // Older app versions did not send replyToCommentId. They may continue
      // replying directly to a top-level comment, but cannot claim a different
      // nested recipient that the rules cannot verify.
      function validLegacyReplyCommentThread(data) {
        let parentId = data.parentCommentId;
        let parentPath = /databases/$(database)/documents/comments/$(parentId);
        let parent = get(parentPath).data;
        return parentId is string
          && parentId.size() > 0
          && data.depth == 1
          && data.get('replyToCommentId', null) == null
          && exists(parentPath)
          && parent.postId == data.postId
          && parent.get('parentCommentId', null) == null
          && parent.get('isDeleted', false) != true
          && data.replyToUserId is string
          && data.replyToUserId == parent.userId;
      }

      function validCommentThread(data) {
        return data.get('parentCommentId', null) == null
          ? validTopLevelCommentThread(data)
          : (
              data.get('replyToCommentId', null) == null
                ? validLegacyReplyCommentThread(data)
                : validReplyCommentThread(data)
            );
      }

      function isCommentSoftDelete() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.auth.uid == resource.data.userId
          && resource.data.get('isDeleted', false) != true
          && request.resource.data.isDeleted == true
          && request.resource.data.deletedAt == request.time
          && request.resource.data.content == ''
          && request.resource.data.authorNickname == ''
          && request.resource.data.authorPhotoUrl == ''
          && request.resource.data.likeCount == 0
          && request.resource.data.likedBy.size() == 0
          && changed.hasOnly([
            'isDeleted', 'deletedAt', 'content', 'authorNickname',
            'authorPhotoUrl', 'likeCount', 'likedBy'
          ]);
      }

      function isCommentLikeUpdate() {
        return resource.data.get('isDeleted', false) != true
          && request.resource.data.get('isDeleted', false) != true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount', 'likedBy']);
      }

      allow read: if canReadCommentTarget(resource.data);
      
      // 생성: 로그인한 사용자만 댓글 작성 가능 (emailVerified 확인)
      // 대댓글 검증: parentCommentId가 있으면 depth는 1, 없으면 depth는 0
      allow create: if 
        request.auth != null &&
        canReadCommentTarget(request.resource.data) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.get('isDeleted', false) == false &&
        request.resource.data.get('deletedAt', null) == null &&
        // 대댓글의 표시 부모, 실제 답글 대상, 수신자 UID가 모두 같은
        // 게시글/스레드에 속하는지 검증한다.
        validCommentThread(request.resource.data);
      
      // 수정: 삭제는 스레드 위치를 보존하는 tombstone 전환만 허용한다.
      // 좋아요는 삭제되지 않은 댓글의 집계 필드만 변경할 수 있다.
      allow update: if 
        request.auth != null &&
        canReadCommentTarget(resource.data) &&
        resource.data.userId != 'deleted' &&
        (isCommentSoftDelete() || isCommentLikeUpdate());
      
      // 클라이언트의 물리 삭제는 스레드 붕괴를 만들므로 금지한다.
      allow delete: if false;
    }
    
    // ===== 기존 호환성 유지 끝 =====

    // ===== Snack Chat 컬렉션 =====
    match /snack_chats/{chatId} {
      function isParticipant() {
        // Once somebody is a room participant, later Meetup visibility or a
        // block must not make the whole group chat (or the leave action)
        // inaccessible. Meetup visibility is checked only while joining.
        return currentUserAccountAllowed()
          && request.auth.uid in resource.data.participantIds;
      }

      function isRoomParticipantById() {
        let roomPath = /databases/$(database)/documents/snack_chats/$(chatId);
        let room = get(roomPath);
        return currentUserAccountAllowed()
          && exists(roomPath)
          && room.data.participantIds is list
          && request.auth.uid in room.data.participantIds;
      }

      function isCreator() {
        return currentUserAccountAllowed()
          && request.auth.uid == resource.data.creatorId;
      }

      function isSelfLeaveUpdate() {
        return isParticipant()
          && !(request.auth.uid in request.resource.data.participantIds)
          && request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1
          && resource.data.participantIds.hasAll(request.resource.data.participantIds)
          && request.resource.data.unreadCount is map
          && request.resource.data.unreadCount.keys().hasAll(
            request.resource.data.participantIds
          )
          && request.resource.data.unreadCount.keys().hasOnly(
            request.resource.data.participantIds
          )
          && request.resource.data.unreadCount.diff(resource.data.unreadCount)
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'creatorId',
            'participantIds',
            'unreadCount',
            'updatedAt'
          ])
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && (
            (
              !isCreator()
              && request.resource.data.creatorId == resource.data.creatorId
            )
            || (
              isCreator()
              && (
                (request.resource.data.participantIds.size() > 0
                  && request.resource.data.creatorId in request.resource.data.participantIds)
                || (request.resource.data.participantIds.size() == 0
                  && request.resource.data.creatorId == '')
              )
            )
          );
      }

      function onlyOwnUnreadReset() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCount'])
          && request.resource.data.unreadCount is map
          && resource.data.unreadCount is map
          && request.resource.data.unreadCount.diff(resource.data.unreadCount)
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.unreadCount[request.auth.uid] == 0;
      }

      function onlyOwnFavoriteToggle() {
        let before = resource.data.get('favoriteUserIds', []);
        let after = request.resource.data.get('favoriteUserIds', []);
        return before is list
          && after is list
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['favoriteUserIds', 'updatedAt'])
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && (
            (
              !(request.auth.uid in before)
              && request.auth.uid in after
              && after.size() == before.size() + 1
              && after.hasAll(before)
            )
            || (
              request.auth.uid in before
              && !(request.auth.uid in after)
              && before.size() == after.size() + 1
              && before.hasAll(after)
            )
          );
      }

      function validClientMessageMetadataUpdate() {
        let lastMessageId = request.resource.data.get('lastMessageId', '');
        let messagePath = /databases/$(database)/documents/snack_chats/$(chatId)/messages/$(lastMessageId);
        let messageAfter = getAfter(messagePath).data;
        let messageType = messageAfter.get('type', 'text');
        let messageText = messageAfter.get('text', '');
        let expectedPreview = messageType == 'image'
          ? (messageText.size() > 0 ? messageText : '[이미지]')
          : (messageType == 'poll' ? '📊 ' + messageText : messageText);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'lastMessageId',
            'lastMessageTime',
            'lastMessageSenderId',
            'lastMessageType',
            'lastMessageExpiresAt',
            'lastMessageSequence',
            'unreadCount',
            'updatedAt'
          ])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 520
          && request.resource.data.lastMessage == expectedPreview
          && lastMessageId is string
          && lastMessageId.size() > 0
          && lastMessageId != resource.data.get('lastMessageId', '')
          && existsAfter(messagePath)
          // The paired message create rule validates type-specific payload,
          // recipients, reply/poll/image data, and the same room sequence/id/
          // sender/time linkage. Repeating those checks here pushes the second
          // message in a room past Firestore's 1,000-expression limit.
          && messageAfter.get('senderId', '') == request.auth.uid
          && messageAfter.get('sequence', 0)
            == request.resource.data.lastMessageSequence
          && messageAfter.get('createdAt', null)
            == request.resource.data.lastMessageTime
          && request.resource.data.lastMessageSenderId == request.auth.uid
          && request.resource.data.lastMessageType in ['text', 'image', 'poll']
          && request.resource.data.lastMessageType == messageType
          && !request.resource.data.keys().hasAny(['lastMessageExpiresAt'])
          && request.resource.data.lastMessageTime is timestamp
          && request.resource.data.lastMessageTime == request.time
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastMessageSequence is int
          && request.resource.data.lastMessageSequence
            == resource.data.get('lastMessageSequence', 0) + 1
          && request.resource.data.unreadCount is map
          && resource.data.unreadCount is map
          // Sending a message must not implicitly mark the sender's existing
          // unread messages as read. The exit-boundary callable is the only
          // normal path that advances the read cursor and aggregate.
          && request.resource.data.unreadCount == resource.data.unreadCount;
      }

      // 일반/Meetup 연결 방 모두 secure callable만 생성한다. Admin SDK는
      // Rules를 우회하며 소유권·frozen audience·server time을 검증한다.
      allow create: if false;

      // 비참여자의 Meetup 참가 검증은 joinMeetupSnackChatSecure callable에서
      // 수행한다. 방 문서의 participantIds/unreadCount는 참여자에게만 노출한다.
      allow read: if isParticipant();

      // 수정: 참여자만 + 허용 필드만 변경. 새 참여자 초대는 직접 update가
      // 아니라 현재 참여자 여부, 활성 계정, 양방향 차단 상태를 검증하는
      // inviteSnackChatParticipants callable에서만 처리한다.
      allow update: if isParticipant() && (
        onlyOwnUnreadReset()
        || onlyOwnFavoriteToggle()
        || validClientMessageMetadataUpdate()
        || isSelfLeaveUpdate()
      );

      allow delete: if false;

      // Snack Chat 메시지
      match /messages/{messageId} {
        function isChatParticipant() {
          let chatPath = /databases/$(database)/documents/snack_chats/$(chatId);
          let chat = get(chatPath);
          return currentUserAccountAllowed()
            && exists(chatPath)
            && chat.data.participantIds is list
            && request.auth.uid in chat.data.participantIds;
        }

        function clientMessageType(data) {
          return data.keys().hasAny(['type'])
            ? data.type
            : (
              (
                data.get('imageUrl', '') is string
                && data.get('imageUrl', '').size() > 0
              )
              || (
                data.get('imagePath', '') is string
                && data.get('imagePath', '').size() > 0
              )
                ? 'image'
                : 'text'
            );
        }

        function validReplySnapshot(data) {
          let originalPath = /databases/$(database)/documents/snack_chats/$(chatId)/messages/$(data.replyToMessageId);
          let original = get(originalPath);
          let originalSenderId = original.data.get('senderId', '');
          let storedSenderName = original.data.get('senderName', '');
          let canonicalSenderName =
            storedSenderName is string && storedSenderName.size() > 0
              ? storedSenderName
              : '';
          let originalText = original.data.get('text', '');
          return exists(originalPath)
            && data.replyPreview is map
            && data.replyPreview.keys().hasOnly([
              'messageId', 'senderId', 'senderName', 'type',
              'textPreview', 'imageUrl', 'imagePath', 'originalFileName',
              'fileExpiresAt', 'isDeleted'
            ])
            && data.replyPreview.messageId == data.replyToMessageId
            // The display text remains a bounded send-time snapshot, but the
            // immutable identity must come from the actual referenced message.
            && data.replyPreview.senderId == originalSenderId
            && data.replyPreview.type == clientMessageType(original.data)
            && data.replyPreview.senderName is string
            && data.replyPreview.senderName.size() <= 80
            // senderId is authoritative. Empty is the canonical client value
            // and also keeps replies compatible with legacy names whose raw
            // whitespace differs from the display-normalized model value.
            && (
              data.replyPreview.senderName == ''
              || data.replyPreview.senderName == canonicalSenderName
            )
            && data.replyPreview.textPreview is string
            && data.replyPreview.textPreview.size() <= 160
            && data.replyPreview.isDeleted is bool
            && data.replyPreview.isDeleted
              == original.data.get('isDeleted', false)
            && originalText is string
            && (
              data.replyPreview.textPreview == ''
              || (
                originalText.size() <= 160
                && data.replyPreview.textPreview == originalText
              )
            )
            && (
              !data.replyPreview.keys().hasAny(['imageUrl'])
              || (
                data.replyPreview.imageUrl is string
                && data.replyPreview.imageUrl.size() < 3000
                && data.replyPreview.imageUrl.matches('https://.*')
                && data.replyPreview.imageUrl
                  == original.data.get('imageUrl', '')
              )
            )
            && (
              !data.replyPreview.keys().hasAny(['imagePath'])
              || (
                data.replyPreview.imagePath is string
                && data.replyPreview.imagePath.size() > 0
                && data.replyPreview.imagePath.size() < 1024
                && data.replyPreview.imagePath
                  == original.data.get('imagePath', '')
                && data.replyPreview.imagePath.matches(
                  'snack_chat_images/'
                  + original.data.get('senderId', '')
                  + '/' + chatId + '/[^/]+'
                )
              )
            )
            && (
              clientMessageType(original.data) != 'file'
                ? !data.replyPreview.keys().hasAny([
                    'originalFileName', 'fileExpiresAt'
                  ])
                : (
                    data.replyPreview.keys().hasAll(['originalFileName'])
                    && data.replyPreview.originalFileName is string
                    && data.replyPreview.originalFileName.size() > 0
                    && data.replyPreview.originalFileName.size() <= 240
                    && data.replyPreview.originalFileName
                      == original.data.get('originalFileName', '')
                    && (
                      original.data.keys().hasAny(['expiresAt'])
                        ? (
                            data.replyPreview.keys().hasAll(['fileExpiresAt'])
                            && data.replyPreview.fileExpiresAt is timestamp
                            && data.replyPreview.fileExpiresAt
                              == original.data.get('expiresAt', null)
                          )
                        : !data.replyPreview.keys()
                            .hasAny(['fileExpiresAt'])
                    )
                  )
            );
        }

        function validReply(data) {
          return !data.keys().hasAny(['replyToMessageId', 'replyPreview'])
            || (
              data.keys().hasAll(['replyToMessageId', 'replyPreview'])
              && data.replyToMessageId is string
              && data.replyToMessageId.size() > 0
              && validReplySnapshot(data)
            );
        }

        function validPollOption(poll, index) {
          let option = poll.options[index];
          return option is map
            && option.keys().hasOnly(['id', 'text'])
            && option.id is string
            && option.id.size() > 0
            && option.id.size() <= 80
            && option.id == poll.optionIds[index]
            && option.text is string
            && option.text.size() > 0
            && option.text.size() <= 120;
        }

        function validPoll(data) {
          return clientMessageType(data) != 'poll' || (
            data.poll is map
            && data.poll.keys().hasOnly([
              'question', 'options', 'optionIds', 'allowMultiple',
              'isAnonymous', 'closesAt', 'voteCounts', 'totalVoters'
            ])
            && data.poll.question is string
            && data.poll.question.size() > 0
            && data.poll.question.size() <= 300
            && data.poll.options is list
            && data.poll.options.size() >= 2
            && data.poll.options.size() <= 10
            && data.poll.optionIds is list
            && data.poll.optionIds.size() == data.poll.options.size()
            && data.poll.optionIds.toSet().size() == data.poll.optionIds.size()
            && validPollOption(data.poll, 0)
            && validPollOption(data.poll, 1)
            && (data.poll.options.size() < 3 || validPollOption(data.poll, 2))
            && (data.poll.options.size() < 4 || validPollOption(data.poll, 3))
            && (data.poll.options.size() < 5 || validPollOption(data.poll, 4))
            && (data.poll.options.size() < 6 || validPollOption(data.poll, 5))
            && (data.poll.options.size() < 7 || validPollOption(data.poll, 6))
            && (data.poll.options.size() < 8 || validPollOption(data.poll, 7))
            && (data.poll.options.size() < 9 || validPollOption(data.poll, 8))
            && (data.poll.options.size() < 10 || validPollOption(data.poll, 9))
            && data.poll.allowMultiple is bool
            && data.poll.isAnonymous is bool
            && data.poll.voteCounts is map
            && data.poll.voteCounts.size() == 0
            && data.poll.totalVoters == 0
            && data.text == data.poll.question
            && (
              !data.poll.keys().hasAny(['closesAt'])
              || (data.poll.closesAt is timestamp && data.poll.closesAt > request.time)
            )
          );
        }

        function validImage(data) {
          return clientMessageType(data) != 'image' || (
            data.keys().hasAll(['imagePath'])
            && !data.keys().hasAny(['imageUrl'])
            && data.imagePath is string
            && data.imagePath.matches(
              'snack_chat_images/' + request.auth.uid + '/' + chatId + '/[^/]+'
            )
          );
        }

        function validTypeSpecificPayload(data) {
          let type = clientMessageType(data);
          return (
              type == 'text'
              && !data.keys().hasAny(['poll', 'imageUrl', 'imagePath'])
            )
            || (
              type == 'image'
              && !data.keys().hasAny(['poll', 'imageUrl'])
              && validImage(data)
            )
            || (
              type == 'poll'
              && !data.keys().hasAny([
                'imageUrl', 'imagePath', 'replyToMessageId', 'replyPreview'
              ])
              && validPoll(data)
            );
        }

        function validClientMessageCreate(data) {
          let roomPath = /databases/$(database)/documents/snack_chats/$(chatId);
          let roomBefore = get(roomPath).data;
          let roomAfter = getAfter(roomPath).data;
          return data.keys().hasOnly([
              'senderId', 'senderName', 'messageScope', 'chatId',
              'type', 'text', 'imageUrl',
              'imagePath', 'createdAt', 'sequence', 'recipientIds', 'readBy',
              'replyToMessageId', 'replyPreview', 'isDeleted',
              'linkPreviewRemoved', 'poll', 'reactionCounts'
            ])
            && data.senderId == request.auth.uid
            && data.messageScope == 'snack_chat'
            && data.chatId == chatId
            // Client-authored profile snapshots race with nickname changes.
            // User messages resolve the live profile at display/push time;
            // server-authored system messages may still carry senderName.
            && !data.keys().hasAny(['senderName'])
            && data.keys().hasAll(['type'])
            && data.type in ['text', 'image', 'poll']
            && data.text is string
            && data.text.size() <= 500
            && (clientMessageType(data) != 'text' || data.text.size() > 0)
            && data.createdAt is timestamp
            && data.createdAt == request.time
            && data.sequence is int
            && data.sequence > 0
            && data.sequence == roomBefore.get('lastMessageSequence', 0) + 1
            && roomAfter.lastMessageSequence == data.sequence
            && roomAfter.lastMessageId == messageId
            // Freeze the actual recipients at send time. This lets read
            // receipts remain correct after later joins/leaves without
            // allowing a sender to omit another current participant.
            && data.recipientIds is list
            && data.recipientIds.toSet().size() == data.recipientIds.size()
            && !(request.auth.uid in data.recipientIds)
            && roomBefore.participantIds.hasAll(data.recipientIds)
            && data.recipientIds.size() == roomBefore.participantIds.size() - 1
            && data.readBy is list
            && data.readBy.size() == 1
            && request.auth.uid in data.readBy
            && data.get('isDeleted', false) == false
            && data.get('linkPreviewRemoved', false) is bool
            && data.get('reactionCounts', {}) is map
            && data.get('reactionCounts', {}).size() == 0
            && validReply(data)
            && validTypeSpecificPayload(data);
        }

        // 읽기: 참여자만
        allow read: if isChatParticipant();

        // 생성: 참여자만, senderId는 본인
        allow create: if isChatParticipant()
          && validClientMessageCreate(request.resource.data);

        // A sender may only opt out of an already-generated preview. Preview
        // creation and all reaction/poll aggregates are Admin SDK writes.
        allow update: if isChatParticipant()
          && request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkPreview', 'linkPreviewRemoved'])
          && request.resource.data.linkPreviewRemoved == true
          && !request.resource.data.keys().hasAny(['linkPreview']);
        allow delete: if false;

        match /reactions/{userId} {
          function parentMessage() {
            return get(
              /databases/$(database)/documents/snack_chats/$(chatId)/messages/$(messageId)
            ).data;
          }

          function validReaction(data) {
            return data.keys().hasOnly([
                'chatId', 'messageId', 'userId', 'emoji', 'updatedAt'
              ])
              && data.chatId == chatId
              && data.messageId == messageId
              && data.userId == request.auth.uid
              && userId == request.auth.uid
              && data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏']
              && data.updatedAt is timestamp
              && data.updatedAt == request.time
              && parentMessage().get('isDeleted', false) != true;
          }

          // Reactions are visible to room participants only. The UI reads
          // this subcollection once when the user opens the reaction detail;
          // normal message rendering uses the parent aggregate instead.
          allow read: if isChatParticipant();
          allow create, update: if isChatParticipant()
            && validReaction(request.resource.data);
          allow delete: if isChatParticipant()
            && userId == request.auth.uid
            && resource.data.userId == request.auth.uid;
        }

        match /votes/{userId} {
          function parentMessage() {
            return get(
              /databases/$(database)/documents/snack_chats/$(chatId)/messages/$(messageId)
            ).data;
          }

          function pollIsOpen() {
            let message = parentMessage();
            return message.get('type', '') == 'poll'
              && message.get('isDeleted', false) != true
              && message.poll is map
              && (
                !message.poll.keys().hasAny(['closesAt'])
                || (message.poll.closesAt is timestamp && request.time < message.poll.closesAt)
              );
          }

          function validVote(data) {
            let poll = parentMessage().poll;
            return pollIsOpen()
              && data.keys().hasOnly([
                'chatId', 'messageId', 'userId', 'optionIds', 'updatedAt'
              ])
              && data.chatId == chatId
              && data.messageId == messageId
              && data.userId == request.auth.uid
              && userId == request.auth.uid
              && data.optionIds is list
              && data.optionIds.size() >= 1
              && data.optionIds.toSet().size() == data.optionIds.size()
              && poll.optionIds is list
              && poll.optionIds.hasAll(data.optionIds)
              && (
                poll.allowMultiple == true
                || data.optionIds.size() == 1
              )
              && data.updatedAt is timestamp
              && data.updatedAt == request.time;
          }

          // Anonymous and non-anonymous polls expose only aggregate results on
          // the parent message plus the caller's own vote document.
          allow get: if isChatParticipant() && userId == request.auth.uid;
          allow list: if false;
          allow create, update: if isChatParticipant()
            && validVote(request.resource.data);
          allow delete: if isChatParticipant()
            && userId == request.auth.uid
            && resource.data.userId == request.auth.uid
            && pollIsOpen();
        }
      }

      match /members/{userId} {
        allow read: if isRoomParticipantById();
        // Missing/stale membership is repaired by the server callable so a
        // client cannot invent its own membership-history boundary.
        allow create: if false;
        allow delete: if false;
        allow update: if isRoomParticipantById()
          && request.auth.uid == userId
          && resource.data.userId == userId
          && request.resource.data.userId == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastReadSequence', 'lastReadAt'])
          && request.resource.data.lastReadSequence is int
          && request.resource.data.lastReadSequence >= resource.data.lastReadSequence
          && request.resource.data.lastReadSequence
            <= get(/databases/$(database)/documents/snack_chats/$(chatId))
              .data.get('lastMessageSequence', 0)
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.lastReadAt == request.time;
      }

      // Upload jobs are server-authored capability records. A sender may read
      // only their own job for local recovery; every mutation goes through an
      // idempotent callable that also validates the Storage object.
      match /fileUploadJobs/{uploadId} {
        allow get: if isRoomParticipantById()
          && resource.data.senderId == request.auth.uid
          && resource.data.uploadId == uploadId;
        allow list: if false;
        allow write: if false;
      }

      // Optional server-maintained aggregate/event documents are readable by
      // current participants but never client-writable.
      match /aggregates/{aggregateId} {
        allow read: if isRoomParticipantById();
        allow write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Collection-group streams used by the Snack Chat screen return only the
    // signed-in user's own raw reaction/vote documents for one room. Direct
    // reaction detail reads remain governed by the participant rule above;
    // other users' raw votes are never exposed.
    match /{snackChatNestedPath=**}/reactions/{reactionId} {
      function canListOwnSnackChatEntry() {
        let chatId = resource.data.get('chatId', '');
        let roomPath = /databases/$(database)/documents/snack_chats/$(chatId);
        return currentUserAccountAllowed()
          && chatId is string
          && resource.data.get('userId', '') == request.auth.uid
          && exists(roomPath)
          && request.auth.uid in get(roomPath).data.participantIds;
      }
      allow list: if canListOwnSnackChatEntry();
    }

    match /{snackChatNestedPath=**}/votes/{voteId} {
      function canListOwnSnackChatEntry() {
        let chatId = resource.data.get('chatId', '');
        let roomPath = /databases/$(database)/documents/snack_chats/$(chatId);
        return currentUserAccountAllowed()
          && chatId is string
          && resource.data.get('userId', '') == request.auth.uid
          && exists(roomPath)
          && request.auth.uid in get(roomPath).data.participantIds;
      }
      allow list: if canListOwnSnackChatEntry();
    }

    // Server-only idempotency and link metadata caches. Explicit rules make
    // the denial durable even if a broad fallback rule is added later.
    match /_snack_chat_function_events/{eventId} {
      allow read, write: if false;
    }

    match /_snack_chat_link_preview_cache/{cacheId} {
      allow read, write: if false;
    }
    
    // ===== DM(Direct Message) 컬렉션 =====
    match /conversations/{conversationId} {
      // conversationId 형식: {작은uid}_{큰uid} (사전순 정렬)
      
      // conversationId에서 사용자 ID 추출 (일반: uid1_uid2, 익명: anon_uid1_uid2_postId)
      function isMyConversationId() {
        let parts = conversationId.split('_');
        let isAnonymous = conversationId.matches('anon_.*');
        
        // 익명 대화방: anon_uid1_uid2_postId 형식
        // parts[0] = 'anon', parts[1] = uid1, parts[2] = uid2, parts[3+] = postId
        return isAnonymous
          ? (parts.size() >= 3 && (request.auth.uid == parts[1] || request.auth.uid == parts[2]))
          : (request.auth.uid in parts);
      }

      function bothParticipantsActive(data) {
        return data.participants is list
          && data.participants.size() == 2
          && activeUserAccount(data.participants[0])
          && activeUserAccount(data.participants[1]);
      }
      
      // 읽기: 대화방 참여자만 (conversationId 기반 최소 방어 포함)
      allow read: if request.auth != null &&
        (
          (resource != null && request.auth.uid in resource.data.participants) ||
          isMyConversationId()
        );
      
      // 생성: 참여자만 가능 + participants가 2명인 신규 대화방만 허용
      // (나가기는 update 규칙에서 처리)
      allow create: if request.auth != null &&
        isMyConversationId() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        bothParticipantsActive(request.resource.data) &&
        request.auth.uid in request.resource.data.participants;
      
      // 수정: (1) 메시지 관련 필드/보관, (2) '나가기' 허용
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        (
          (
            // 일반 메시지 관련 변경 + 보관 + 나가기 기록
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageSenderId', 'updatedAt', 'archivedBy', 'userLeftAt'])
          ) ||
          (
            // 레거시 '나가기': participants에서 본인만 제거 (N → N-1).
            // unreadCount는 callable/trigger만 변경할 수 있다.
            request.auth.uid in resource.data.participants &&
            !(request.auth.uid in request.resource.data.participants) &&
            request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
            // 남아있는 모든 참여자는 기존 참여자 중 일부여야 함 (여기서는 1명만 남는 구조)
            request.resource.data.participants.size() == 1 &&
            request.resource.data.participants[0] in resource.data.participants &&
            request.resource.data.unreadCount == resource.data.unreadCount &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants','updatedAt'])
          )
        );
      
      // 삭제: 대화방 참여자라면 삭제 가능 (클라이언트에서 메시지 먼저 삭제 후 문서 삭제)
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // ===== 메시지 서브컬렉션 =====
      match /messages/{messageId} {
        // 읽기: 대화방 참여자만
        // get() 호출 최소화를 위해 함수 사용
        function isParticipant() {
          // 대화방이 존재하면 participants 체크
          return exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        function bothRoomParticipantsActive() {
          let room = get(/databases/$(database)/documents/conversations/$(conversationId));
          return exists(/databases/$(database)/documents/conversations/$(conversationId))
            && room.data.participants is list
            && room.data.participants.size() == 2
            && activeUserAccount(room.data.participants[0])
            && activeUserAccount(room.data.participants[1]);
        }
        
        // conversationId에서 사용자 ID 추출 (일반: uid1_uid2, 익명: anon_uid1_uid2_postId)
        function isMyConversation() {
          let parts = conversationId.split('_');
          let isAnonymous = conversationId.matches('anon_.*');
          
          // 익명 대화방: anon_uid1_uid2_postId 형식
          // parts[0] = 'anon', parts[1] = uid1, parts[2] = uid2, parts[3+] = postId
          return isAnonymous 
            ? (parts.size() >= 3 && (request.auth.uid == parts[1] || request.auth.uid == parts[2]))
            : (request.auth.uid in parts);
        }
        
        // 개별 메시지 읽기
        allow get: if request.auth != null && (isParticipant() || isMyConversation());
        
        // 메시지 목록 조회
        allow list: if request.auth != null && (isParticipant() || isMyConversation());
        
        // 생성: 핵심 검증만 유지
        allow create: if request.auth != null &&
          (isParticipant() || isMyConversation()) &&
          bothRoomParticipantsActive() &&
          // 발신자는 본인
          request.auth.uid == request.resource.data.senderId &&
          // DM은 post_context 타입만 사용한다. Snack Chat의 투표/시스템
          // 수명주기 필드를 주입해 전역 messages collection-group 작업을
          // 고갈시키지 못하게 경계를 명시한다.
          (
            !request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type == 'post_context'
          ) &&
          !request.resource.data.keys().hasAny([
            'poll', 'pollCloseNotifiedAt', 'reactionCounts',
            'recipientIds', 'sequence', 'eventId'
          ]) &&
          // 텍스트/이미지 중 하나는 있어야 함 (이미지 메시지 지원)
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 500 &&
          (
            request.resource.data.text.size() > 0 ||
            (request.resource.data.keys().hasAny(['imageUrl']) &&
             request.resource.data.imageUrl is string &&
             request.resource.data.imageUrl.size() > 0 &&
             request.resource.data.imageUrl.size() < 3000)
          ) &&
          // 초기 읽음 상태는 false
          request.resource.data.isRead == false;
        
        // 수정: 읽음 처리 로직만 유지. affectedKeys 제한으로 위 Snack
        // Chat 전용 필드를 기존 DM에 사후 주입하는 것도 불가능하다.
        allow update: if request.auth != null &&
          (isParticipant() || isMyConversation()) &&
          // 수신자만 읽음 처리 가능
          request.auth.uid != resource.data.senderId &&
          // isRead만 false→true로 변경
          resource.data.isRead == false &&
          request.resource.data.isRead == true &&
          // 다른 필드는 변경 불가
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);
        
        // 삭제: 대화방 참여자는 자신의 채팅방 하위 메시지를 삭제 가능 (대화방 완전 삭제 시 사용)
        allow delete: if request.auth != null && (isParticipant() || isMyConversation());
      }
    }

    // ===== 신고 컬렉션 =====
    match /reports/{reportId} {
      // 생성: 인증된 사용자 누구나 가능 (신고하기)
      // 단, 신고자는 본인이어야 함
      allow create: if 
        request.auth != null &&
        request.auth.uid == request.resource.data.reporterId &&
        // Snack Chat reports must be created by the server so the original
        // message snapshot and room membership cannot be forged.
        request.resource.data.get('targetType', '') != 'snack_chat_message';
      
      // 읽기/수정/삭제: 관리자만 가능 (일반 사용자는 본인 신고도 수정/삭제 불가)
      allow read, update, delete: if false; 
    }

    // ===== 익명 게시글 차단 컬렉션 =====
    match /anonymous_post_blocks/{blockId} {
      // 읽기: 본인이 차단한 항목만 읽기 가능
      // blockId 형식: {blockerUid}_{postId}
      allow read: if 
        request.auth != null &&
        (
          // 문서가 존재하는 경우: 차단자 본인만
          (resource != null && request.auth.uid == resource.data.blockerUid) ||
          // 문서가 존재하지 않는 경우: blockId 패턴에 자신의 ID 포함 시
          (resource == null && blockId.matches(request.auth.uid + '_.*'))
        );
      
      // 생성/삭제: Cloud Functions만 가능 (보안 강화)
      allow write: if false;
    }

    // ===== 익명 댓글 숨김 컬렉션 =====
    match /hidden_comments/{hideId} {
      // 읽기: 본인이 숨긴 항목만 읽기 가능
      // hideId 형식: {blockerUid}_{commentId}
      allow read: if 
        request.auth != null &&
        (
          // 문서가 존재하는 경우: 숨김 처리자 본인만
          (resource != null && request.auth.uid == resource.data.blockerUid) ||
          // 문서가 존재하지 않는 경우: hideId 패턴에 자신의 ID 포함 시
          (resource == null && hideId.matches(request.auth.uid + '_.*'))
        );
      
      // 생성/삭제: Cloud Functions만 가능 (보안 강화)
      allow write: if false;
    }
  }
}
