# Runtime configuration for Cloud Functions (applied to deployed functions and
# the emulator; no secrets here). NOTE: `firebase deploy` does NOT pass these
# values to the step that analyses the code, so anything that decides *where*
# a function is deployed (regions) lives in functions/src/backend.ts
# (DEFAULT_CALLABLE_REGION / DEFAULT_EVENT_REGION) and changes by commit.
# See docs/seoul_cutover_runbook.md for the migration sequence.

# Bucket for objects the backend writes itself and the default returned to
# clients that do not declare one. P1-2 (2026-10-05): Seoul bucket.
WEFILLING_UPLOAD_BUCKET=flutterproject3-af322-kr

# Gmail sender. The app password is a Secret Manager secret:
#   firebase functions:secrets:set GMAIL_PASSWORD
# Set WEFILLING_MAIL_SECRET=off to deploy mail functions without the binding.
GMAIL_USER=wefilling@gmail.com
WEFILLING_MAIL_SECRET=on

# Chat push presentation v2 (room title / sender / unread subtitle, DM thread).
# Runtime flag read inside the triggers; the client mirrors it with the
# CHAT_PUSH_PRESENTATION_V2 default in lib/utils/chat_notification_presentation.dart.
CHAT_PUSH_PRESENTATION_V2=true
