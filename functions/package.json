{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:nicknames": "node scripts/migrate_nickname_claims.js",
    "migrate:content-search": "node scripts/migrate_content_search_indexes.js",
    "test:content-search": "node scripts/test_content_search_helpers.js",
    "test:content-translation": "npm run build && node scripts/test_content_translation_temporal_policy.js",
    "test:content-translation-latency": "npm run build && node scripts/test_content_translation_latency.js",
    "canary:content-translation": "npm run build && node scripts/canary_content_translation_temporal.js",
    "test:snack-summary": "npm run build && node scripts/test_snack_chat_unread_summary_helpers.js && node scripts/test_snack_chat_structured_summary_schema_contract.js",
    "test:snack-summary-schema": "npm run build && node scripts/test_snack_chat_structured_summary_schema_contract.js",
    "canary:snack-summary-schema": "npm run build && node scripts/canary_snack_chat_structured_summary_schema.js",
    "test:auth-registration": "node scripts/test_auth_registration_helpers.js",
    "test:user-interest-search": "npm run build && node scripts/test_user_interest_search_helpers.js",
    "test:user-search-policy": "npm run build && node scripts/test_searchable_user_policy.js",
    "test:nickname-policy": "npm run build && node scripts/test_nickname_policy.js",
    "audit:user-search-lifecycle": "npm run build && node scripts/audit_user_search_lifecycle.js",
    "audit:nickname-normalization": "npm run build && node scripts/audit_nickname_normalization.js",
    "migrate:friend-counts": "npm run build && node scripts/migrate_friend_counts.js",
    "migrate:review-projections": "node scripts/migrate_review_profile_projections.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
